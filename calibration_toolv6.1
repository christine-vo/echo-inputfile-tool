/* ── CSV ── */
function exportCSV(){
  const rows=[['Set Name','Trial','R2','Linear Dynamic Range (ppm)','Linearity']];
  chartStates.forEach((row,si)=>row.forEach((s,ti)=>{
    if(s.invalid){
      rows.push([setNames[si],'Trial '+(ti+1),'-','-','-']);
      return;
    }
    const inc=s.originalPoints.filter((_,i)=>!s.excluded.has(i));
    let r2='';
    if(inc.length>=2){
      const f=s.fitType==='linear'?linReg(inc):quadReg(inc);
      if(f)r2=calcR2(inc,f.predict).toFixed(4);
    }
    const xs=inc.map(p=>p.x);
    const range=xs.length?sigFig(Math.min(...xs),3)+' - '+sigFig(Math.max(...xs),3):'';
    rows.push([setNames[si],'Trial '+(ti+1),r2,range,
               s.fitType==='linear'?'Linear':'Quadratic']);
  }));
  const blob=new Blob(['\uFEFF'+rows.map(r=>r.map(c=>'"'+c+'"').join(',')).join('\r\n')],
    {type:'text/csv;charset=utf-8;'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);a.download='summary.csv';a.click();
}

/* ── PDF ── */
async function exportPDF(doSummary,doCurves,doData){
  const {jsPDF}=window.jspdf;
  const doc=new jsPDF({orientation:'portrait',unit:'mm',format:'a4'});
  const pageW=doc.internal.pageSize.getWidth();
  const pageH=doc.internal.pageSize.getHeight();
  const margin=15;let y=margin;

  function checkPage(need){if(y+need>pageH-margin){doc.addPage();y=margin;}}
  function sectionTitle(txt){
    checkPage(12);
    doc.setFontSize(13);doc.setFont(undefined,'bold');doc.setTextColor(44,82,130);
    doc.text(txt,margin,y);y+=8;
    doc.setTextColor(0,0,0);doc.setFont(undefined,'normal');
  }
  function subTitle(txt){
    checkPage(10);
    doc.setFontSize(11);doc.setFont(undefined,'bold');
    doc.text(txt,margin,y);y+=6;doc.setFont(undefined,'normal');
  }

  /* Summary */
  if(doSummary){
    sectionTitle('Summary Table');
    const head=[['Set Name','Trial','R2','Linear Dynamic Range (ppm)','Linearity']];
    const body=chartStates.flatMap((row,si)=>row.map((s,ti)=>{
      if(s.invalid)
        return[setNames[si],'Trial '+(ti+1),'-','-','-'];
      const inc=s.originalPoints.filter((_,i)=>!s.excluded.has(i));
      let r2='\u2014';
      if(inc.length>=2){
        const f=s.fitType==='linear'?linReg(inc):quadReg(inc);
        if(f)r2=calcR2(inc,f.predict).toFixed(4);
      }
      const xs=inc.map(p=>p.x);
      const range=xs.length
        ?sigFig(Math.min(...xs),3)+' - '+sigFig(Math.max(...xs),3):'\u2014';
      return[setNames[si],'Trial '+(ti+1),r2,range,
             s.fitType==='linear'?'Linear':'Quadratic'];
    }));
    doc.autoTable({startY:y,head,body,margin:{left:margin,right:margin},
      headStyles:{fillColor:[66,153,225]},styles:{fontSize:9}});
    y=doc.lastAutoTable.finalY+10;
  }

  /* Calibration Curves */
  if(doCurves){
    sectionTitle('Calibration Curves');
    for(let si=0;si<chartStates.length;si++){
      for(let ti=0;ti<chartStates[si].length;ti++){
        const s=chartStates[si][ti];
        const inc=s.originalPoints.filter((_,i)=>!s.excluded.has(i));

        let fit=null;
        if(!s.invalid&&inc.length>=2)
          fit=s.fitType==='linear'?linReg(inc):quadReg(inc);

        const r2=fit?calcR2(inc,fit.predict):NaN;
        const r2str=s.invalid?'-':isNaN(r2)?'N/A':r2.toFixed(4);
        const fmStr=s.invalid?'':buildFormulaString(fit,s.fitType);

        const src=inc.length>0?inc:s.originalPoints;
        const xMin=Math.min(...src.map(p=>p.x)),xMax=Math.max(...src.map(p=>p.x));
        const yMin=Math.min(...src.map(p=>p.y)),yMax=Math.max(...src.map(p=>p.y));
        const xPad=(xMax-xMin)*0.08||1,yPad=(yMax-yMin)*0.08||1;
        const axXmin=xMin-xPad,axXmax=xMax+xPad,axYmin=yMin-yPad,axYmax=yMax+yPad;

        const fitLine=[];
        if(fit)for(let i=0;i<=120;i++){
          const x=axXmin+(axXmax-axXmin)*i/120;
          fitLine.push({x,y:fit.predict(x)});
        }

        const oc=document.createElement('canvas');
        oc.width=900;oc.height=500;
        const octx=oc.getContext('2d');
        octx.fillStyle='#ffffff';octx.fillRect(0,0,900,500);

        const ec=new Chart(octx,{
          type:'scatter',
          data:{datasets:[
            {data:inc.map(p=>({x:p.x,y:p.y})),
             backgroundColor: s.invalid?'rgba(160,174,192,0.5)':'#4299e1',
             borderColor:     s.invalid?'#a0aec0':'#2b6cb0',
             pointRadius:6,pointStyle:'circle',showLine:false,order:2},
            {data:fitLine,type:'line',
             borderColor:'#e53e3e',borderWidth:2.5,borderDash:[10,6],
             pointRadius:0,fill:false,tension:0,order:1}
          ]},
          options:{
            responsive:false,animation:false,
            scales:{
              x:{type:'linear',min:axXmin,max:axXmax,
                 title:{display:true,text:'Conc. (ppm)',font:{size:14}},
                 grid:{display:false},border:{display:true}},
              y:{min:axYmin,max:axYmax,
                 title:{display:true,text:'Intensity',font:{size:14}},
                 grid:{display:false},border:{display:true}}
            },
            plugins:{legend:{display:false},tooltip:{enabled:false}}
          }
        });

        await new Promise(r=>setTimeout(r,60));
        const imgData=oc.toDataURL('image/png',1.0);
        ec.destroy();

        checkPage(20);
        subTitle((setNames[si]||`Set ${si+1}`)+' \u2014 Trial '+(ti+1)+
                 (s.invalid?' [INVALID]':''));
        doc.setFontSize(9);
        doc.text('R2 = '+r2str,margin,y);y+=5;
        if(fmStr){doc.text(fmStr,margin,y);y+=5;}
        const imgW=pageW-margin*2,imgH=imgW*(500/900);
        checkPage(imgH+8);
        doc.addImage(imgData,'PNG',margin,y,imgW,imgH);
        y+=imgH+12;
      }
    }
  }

  /* Data Points */
  if(doData){
    sectionTitle('Data Points');
    for(let si=0;si<chartStates.length;si++){
      for(let ti=0;ti<chartStates[si].length;ti++){
        const s=chartStates[si][ti];
        const inc=s.originalPoints.filter((_,i)=>!s.excluded.has(i));
        checkPage(20);
        subTitle((setNames[si]||`Set ${si+1}`)+' \u2014 Trial '+(ti+1)+
                 (s.invalid?' [INVALID]':''));
        if(s.invalid){
          doc.setFontSize(9);doc.setTextColor(197,48,48);
          doc.text('This trial was marked as invalid.',margin,y);
          doc.setTextColor(0,0,0);y+=8;
          continue;
        }
        doc.autoTable({startY:y,head:[['Conc. (ppm)','Intensity']],
          body:inc.map(p=>[p.x,p.y]),
          margin:{left:margin,right:margin},
          headStyles:{fillColor:[66,153,225]},styles:{fontSize:9}});
        y=doc.lastAutoTable.finalY+8;
      }
    }
  }

  doc.save('calibration_report.pdf');
}
</script>
</body>
</html>
