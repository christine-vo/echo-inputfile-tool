<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Input File Creator</title>
<script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --bg: #f0f2f5;
    --surface: #ffffff;
    --border: #d1d5db;
    --text: #1f2937;
    --text-muted: #6b7280;
    --primary: #2563eb;
    --radius: 8px;
    --shadow: 0 1px 3px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.08);
    --shadow-lg: 0 4px 16px rgba(0,0,0,0.12);
    --well-size: 36.4px;
    --well-gap: 3.9px;
    --font: 'Segoe UI', system-ui, -apple-system, sans-serif;
  }
  body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-size: 1.3rem;
  }

  /* ── Top Bar ── */
  #topbar {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow);
    padding: 10px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  #topbar h1 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    margin-right: 8px;
    white-space: nowrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s, opacity 0.15s;
    white-space: nowrap;
    font-family: var(--font);
    background: var(--surface);
    color: var(--text);
  }
  .btn:hover:not(:disabled) { background: #f3f4f6; }
  .btn:active { transform: scale(0.97); }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
  .btn-primary { background: var(--primary); color: #fff; border-color: var(--primary); }
  .btn-primary:hover:not(:disabled) { background: #1d4ed8; border-color: #1d4ed8; }
  .btn-danger { color: #dc2626; border-color: #fca5a5; }
  .btn-danger:hover:not(:disabled) { background: #fef2f2; }
  .btn-eraser.active {
    background: #f3f4f6;
    border-color: var(--text-muted);
    box-shadow: inset 0 1px 3px rgba(0,0,0,0.15);
  }
  .btn svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sep { width: 1px; height: 28px; background: var(--border); margin: 0 2px; }
  #status-bar {
    margin-left: auto;
    font-size: 0.78rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* ── Filename group ── */
  #filename-group {
    display: flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  #filename-group label {
    padding: 0 10px;
    font-size: 0.78rem;
    color: var(--text-muted);
    white-space: nowrap;
    background: #f9fafb;
    border-right: 1px solid var(--border);
    height: 100%;
    display: flex;
    align-items: center;
    user-select: none;
  }
  #filename-input {
    border: none;
    outline: none;
    padding: 6px 10px;
    font-size: 0.82rem;
    font-family: var(--font);
    color: var(--text);
    background: transparent;
    width: 180px;
  }
  #filename-input::placeholder { color: #9ca3af; }
  #filename-suffix {
    padding: 0 10px;
    font-size: 0.78rem;
    color: var(--text-muted);
    background: #f9fafb;
    border-left: 1px solid var(--border);
    height: 100%;
    display: flex;
    align-items: center;
    user-select: none;
  }

  /* ── Export order selector ── */
  #order-group {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  #order-group .order-label {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-left: 2px;
  }
  #order-btns {
    display: flex;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .order-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    padding: 5px 12px;
    border: none;
    background: var(--surface);
    cursor: pointer;
    font-family: var(--font);
    transition: background 0.15s;
    border-right: 1px solid var(--border);
    min-width: 0;
  }
  .order-btn:last-child { border-right: none; }
  .order-btn:hover { background: #f3f4f6; }
  .order-btn.active {
    background: #eff6ff;
    box-shadow: inset 0 -2px 0 var(--primary);
  }
  .order-btn .ob-title {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }
  .order-btn.active .ob-title { color: var(--primary); }
  .order-btn .ob-example {
    font-size: 0.65rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* ── Main Layout ── */
  #main { display: flex; flex: 1; overflow: hidden; }

  /* ── Plate Area ── */
  #plate-area {
    flex: 1;
    overflow: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  #plate-wrapper {
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    padding: 16px;
    display: inline-block;
    user-select: none;
  }
  #plate-grid {
    display: grid;
    grid-template-columns: 24px repeat(24, var(--well-size));
    grid-template-rows: 20px repeat(16, var(--well-size));
    gap: var(--well-gap);
  }
  .col-label {
    display: flex; align-items: center; justify-content: center;
    font-size: 0.81rem; font-weight: 700; color: var(--text-muted);
  }
  .row-label {
    display: flex; align-items: center; justify-content: center;
    font-size: 0.85rem; font-weight: 700; color: var(--text-muted);
  }
  .well {
    width: var(--well-size);
    height: var(--well-size);
    border-radius: 50%;
    border: 1.5px solid #9ca3af;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: crosshair;
    transition: transform 0.1s, box-shadow 0.1s, border-color 0.1s;
    background: #f9fafb;
    position: relative;
  }
  .well:hover {
    transform: scale(1.12);
    box-shadow: 0 0 0 2px var(--primary);
    z-index: 10;
    border-color: var(--primary);
  }
  .well.colored { border-color: rgba(0,0,0,0.2); }
  .well-label {
    pointer-events: none;
    font-size: 0.57rem;
    font-weight: 700;
    line-height: 1;
    color: #4b5563;
  }
  .well.colored .well-label { color: rgba(0,0,0,0.5); }

  /* ── Sidebar ── */
  #sidebar {
    width: 280px;
    min-width: 260px;
    background: var(--surface);
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  #sidebar-header {
    padding: 14px 16px 10px;
    border-bottom: 1px solid var(--border);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  #palette-list {
    flex: 1;
    overflow-y: auto;
    padding: 8px 12px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .palette-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 6px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.12s;
    border: 2px solid transparent;
  }
  .palette-row:hover { background: #f9fafb; }
  .palette-row.active { border-color: var(--primary); background: #eff6ff; }
  .color-swatch {
    width: 22px; height: 22px;
    border-radius: 4px;
    border: 1px solid rgba(0,0,0,0.15);
    flex-shrink: 0;
  }
  .formula-input {
    flex: 1;
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 4px 7px;
    font-size: 0.78rem;
    font-family: var(--font);
    color: var(--text);
    background: #fff;
    transition: border-color 0.15s;
    min-width: 0;
  }
  .formula-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 2px rgba(37,99,235,0.15);
  }
  .well-count-badge {
    font-size: 0.68rem;
    background: #e5e7eb;
    color: var(--text-muted);
    border-radius: 10px;
    padding: 1px 6px;
    flex-shrink: 0;
    min-width: 22px;
    text-align: center;
  }
  #sidebar-footer {
    padding: 10px 14px;
    border-top: 1px solid var(--border);
    font-size: 0.72rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* ── Modal ── */
  #modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 999;
    align-items: center;
    justify-content: center;
  }
  #modal-overlay.show { display: flex; }
  #modal {
    background: var(--surface);
    border-radius: 12px;
    padding: 28px 32px;
    max-width: 360px;
    width: 90%;
    box-shadow: var(--shadow-lg);
    text-align: center;
  }
  #modal h2 { font-size: 1rem; font-weight: 700; margin-bottom: 10px; }
  #modal p  { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 22px; line-height: 1.5; }
  #modal .modal-btns { display: flex; gap: 10px; justify-content: center; }

  /* ── Toast ── */
  #toast {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%) translateY(80px);
    background: #1f2937;
    color: #fff;
    padding: 9px 20px;
    border-radius: 24px;
    font-size: 0.82rem;
    font-weight: 500;
    box-shadow: var(--shadow-lg);
    transition: transform 0.3s ease, opacity 0.3s ease;
    opacity: 0;
    z-index: 9999;
    pointer-events: none;
  }
  #toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }
</style>
</head>
<body>

<div id="topbar">
  <h1>Input File Creator</h1>
  <div class="sep"></div>

  <button class="btn" id="btn-undo" title="Undo (Ctrl+Z)">
    <svg viewBox="0 0 24 24"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.95"/></svg>
    Undo
  </button>

  <button class="btn" id="btn-redo" title="Redo (Ctrl+Y)">
    <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-.49-4.95"/></svg>
    Redo
  </button>

  <div class="sep"></div>

  <button class="btn btn-eraser" id="btn-eraser">
    <svg viewBox="0 0 24 24"><path d="M20 20H7L3 16l10-10 7 7-3.5 3.5"/><path d="M6.5 17.5l4-4"/></svg>
    Eraser
  </button>

  <div class="sep"></div>

  <button class="btn btn-danger" id="btn-clear">
    <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
    Restart
  </button>

  <div class="sep"></div>

  <!-- Export order selector -->
  <div id="order-group">
    <div class="order-label">Export order</div>
    <div id="order-btns">
      <button class="order-btn" id="order-col" title="Column-major: A1, B1, C1 ...">
        <span class="ob-title">By Column</span>
        <span class="ob-example">A1, B1, C1 ...</span>
      </button>
      <button class="order-btn active" id="order-row" title="Row-major: A1, A2, A3 ...">
        <span class="ob-title">By Row</span>
        <span class="ob-example">A1, A2, A3 ...</span>
      </button>
    </div>
  </div>

  <div class="sep"></div>

  <!-- Filename -->
  <div id="filename-group">
    <label for="filename-input">File name</label>
    <input type="text" id="filename-input" placeholder="input_file_YYYY-MM-DD" autocomplete="off" spellcheck="false" />
    <span id="filename-suffix">.xlsx</span>
  </div>

  <button class="btn btn-primary" id="btn-export">
    <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
    Export .xlsx
  </button>

  <span id="status-bar">384-well plate &middot; 0 wells colored</span>
</div>

<div id="main">
  <div id="plate-area">
    <div id="plate-wrapper">
      <div id="plate-grid"></div>
    </div>
  </div>
  <div id="sidebar">
    <div id="sidebar-header">Color Palette &amp; Formulas</div>
    <div id="palette-list"></div>
    <div id="sidebar-footer">
      Select a color, then click or drag wells to paint.<br>
      Type a formula name next to each color.
    </div>
  </div>
</div>

<div id="modal-overlay">
  <div id="modal">
    <h2>Clear Entire Plate?</h2>
    <p>All well colors and formula entries will be removed. This cannot be undone.</p>
    <div class="modal-btns">
      <button class="btn btn-danger" id="modal-confirm">Yes, Clear All</button>
      <button class="btn" id="modal-cancel">Cancel</button>
    </div>
  </div>
</div>

<div id="toast"></div>

<script>
// ── Constants ──────────────────────────────────────────────
const ROWS = ['A','B','C','D','E','F','G','H','I','J','K','L','M','N','O','P'];
const COLS = Array.from({length: 24}, (_, i) => i + 1);
const NUM_COLORS = 16;

const PALETTE = [
  '#4e79a7','#f28e2b','#59a14f','#e15759',
  '#76b7b2','#edc948','#b07aa1','#ff9da7',
  '#9c755f','#bab0ac','#d37295','#a0cbe8',
  '#8cd17d','#b6992d','#499894','#86bcb6'
];

// ── State ──────────────────────────────────────────────────
let plateState   = {};
let formulas     = Array(NUM_COLORS).fill('');
let activeColor  = 0;
let eraserMode   = false;
let exportByRow  = true;   // true = row-major (A1,A2...), false = col-major (A1,B1...)

let isDragging     = false;
let dragSnapshot   = null;
let dragBuffer     = [];
let dragHasPainted = false;

let undoStack = [];
let redoStack = [];

// ── Helpers ────────────────────────────────────────────────
function posKey(ri, ci) { return `${ROWS[ri]}${COLS[ci]}`; }
function snapshotState() { return JSON.parse(JSON.stringify(plateState)); }

function pushUndo(snapshot) {
  undoStack.push(snapshot);
  if (undoStack.length > 200) undoStack.shift();
  redoStack = [];
  syncUndoRedoBtns();
}

function syncUndoRedoBtns() {
  document.getElementById('btn-undo').disabled = undoStack.length === 0;
  document.getElementById('btn-redo').disabled = redoStack.length === 0;
}

function updateStatusBar() {
  const n = Object.keys(plateState).length;
  document.getElementById('status-bar').textContent =
    `384-well plate \u00b7 ${n} well${n !== 1 ? 's' : ''} colored`;
}

function updateWellCountBadges() {
  const counts = Array(NUM_COLORS).fill(0);
  Object.values(plateState).forEach(ci => counts[ci]++);
  document.querySelectorAll('.well-count-badge').forEach((el, i) => {
    el.textContent = counts[i] > 0 ? counts[i] : '';
  });
}

function showToast(msg, duration = 2500) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._timer);
  t._timer = setTimeout(() => t.classList.remove('show'), duration);
}

function contrastColor(hex) {
  const r = parseInt(hex.slice(1,3), 16);
  const g = parseInt(hex.slice(3,5), 16);
  const b = parseInt(hex.slice(5,7), 16);
  const lum = (0.299*r + 0.587*g + 0.114*b) / 255;
  return lum > 0.55 ? 'rgba(0,0,0,0.6)' : 'rgba(255,255,255,0.85)';
}

function sanitizeFilename(raw) {
  return raw
    .trim()
    .replace(/[\\/:*?"<>|]/g, '')
    .replace(/\s+/g, '_')
    .replace(/\.xlsx$/i, '')
    .slice(0, 100);
}

function resolveFilename() {
  const raw     = document.getElementById('filename-input').value;
  const cleaned = sanitizeFilename(raw);
  if (cleaned.length > 0) return `${cleaned}.xlsx`;
  const dateStr = new Date().toISOString().slice(0, 10);
  return `input_file_${dateStr}.xlsx`;
}

function downloadWorkbook(workbook, filename) {
  try {
    XLSX.writeFile(workbook, filename);
    return true;
  } catch (err) {
    try {
      const wbout = XLSX.write(workbook, { bookType: 'xlsx', type: 'array' });
      const blob = new Blob([wbout], {
        type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
      });
      const link = document.createElement('a');
      const url = URL.createObjectURL(blob);
      link.href = url;
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      return true;
    } catch (fallbackErr) {
      console.error('Workbook download failed:', fallbackErr);
      return false;
    }
  }
}

// ── Export order toggle ────────────────────────────────────
document.getElementById('order-row').addEventListener('click', () => {
  exportByRow = true;
  document.getElementById('order-row').classList.add('active');
  document.getElementById('order-col').classList.remove('active');
});

document.getElementById('order-col').addEventListener('click', () => {
  exportByRow = false;
  document.getElementById('order-col').classList.add('active');
  document.getElementById('order-row').classList.remove('active');
});

// ── Build Plate ────────────────────────────────────────────
function buildPlate() {
  const grid = document.getElementById('plate-grid');
  grid.innerHTML = '';

  grid.appendChild(document.createElement('div'));

  COLS.forEach(c => {
    const el = document.createElement('div');
    el.className = 'col-label';
    el.textContent = c;
    grid.appendChild(el);
  });

  ROWS.forEach((r, ri) => {
    const rl = document.createElement('div');
    rl.className = 'row-label';
    rl.textContent = r;
    grid.appendChild(rl);

    COLS.forEach((c, ci) => {
      const key  = posKey(ri, ci);
      const well = document.createElement('div');
      well.className = 'well';
      well.dataset.row = ri;
      well.dataset.col = ci;
      well.dataset.key = key;
      well.title = key;

      const lbl = document.createElement('span');
      lbl.className = 'well-label';
      lbl.textContent = key;
      well.appendChild(lbl);

      grid.appendChild(well);
    });
  });

  grid.addEventListener('mousedown', e => {
    const well = e.target.closest('.well');
    if (!well || e.button !== 0) return;
    e.preventDefault();
    isDragging     = true;
    dragSnapshot   = snapshotState();
    dragBuffer     = [];
    dragHasPainted = false;
    applyToWell(well, eraserMode ? null : activeColor);
  });

  grid.addEventListener('mousemove', e => {
    if (!isDragging) return;
    const well = e.target.closest('.well');
    if (well) applyToWell(well, eraserMode ? null : activeColor);
  });

  grid.addEventListener('mouseup', endDrag);
  document.addEventListener('mouseup', () => { if (isDragging) endDrag(); });
}

function endDrag() {
  if (!isDragging) return;
  isDragging = false;
  if (dragHasPainted && dragSnapshot !== null) pushUndo(dragSnapshot);
  dragSnapshot   = null;
  dragBuffer     = [];
  dragHasPainted = false;
}

// ── Paint Logic ────────────────────────────────────────────
function paintWell(wellEl, colorIndex) {
  const key = wellEl.dataset.key;
  if (colorIndex === null) {
    delete plateState[key];
    wellEl.style.background = '';
    wellEl.classList.remove('colored');
    wellEl.querySelector('.well-label').style.color = '';
  } else {
    plateState[key] = colorIndex;
    const color = PALETTE[colorIndex];
    wellEl.style.background = color;
    wellEl.classList.add('colored');
    wellEl.querySelector('.well-label').style.color = contrastColor(color);
  }
}

function applyToWell(wellEl, ci) {
  const key     = wellEl.dataset.key;
  if (dragBuffer.includes(key)) return;
  const current = plateState[key];
  const changed = (ci === null && current !== undefined) ||
                  (ci !== null && current !== ci);
  if (!changed) return;
  dragBuffer.push(key);
  dragHasPainted = true;
  paintWell(wellEl, ci);
  updateStatusBar();
  updateWellCountBadges();
}

function refreshAllWells() {
  document.querySelectorAll('.well').forEach(w => {
    const key = w.dataset.key;
    if (plateState[key] !== undefined) {
      const ci = plateState[key];
      w.style.background = PALETTE[ci];
      w.classList.add('colored');
      w.querySelector('.well-label').style.color = contrastColor(PALETTE[ci]);
    } else {
      w.style.background = '';
      w.classList.remove('colored');
      w.querySelector('.well-label').style.color = '';
    }
  });
  updateStatusBar();
  updateWellCountBadges();
}

// ── Build Sidebar ──────────────────────────────────────────
function buildPalette() {
  const list = document.getElementById('palette-list');
  list.innerHTML = '';

  PALETTE.forEach((color, i) => {
    const row = document.createElement('div');
    row.className = 'palette-row' + (i === 0 ? ' active' : '');

    const swatch = document.createElement('div');
    swatch.className = 'color-swatch';
    swatch.style.background = color;

    const input = document.createElement('input');
    input.type = 'text';
    input.className = 'formula-input';
    input.placeholder = `Formula ${i + 1}`;
    input.value = formulas[i];
    input.addEventListener('input', e => { formulas[i] = e.target.value; });
    input.addEventListener('mousedown', e => e.stopPropagation());

    const badge = document.createElement('span');
    badge.className = 'well-count-badge';

    row.appendChild(swatch);
    row.appendChild(input);
    row.appendChild(badge);

    row.addEventListener('click', e => {
      if (e.target === input) return;
      selectColor(i);
    });

    list.appendChild(row);
  });
}

function selectColor(index) {
  activeColor = index;
  eraserMode  = false;
  document.getElementById('btn-eraser').classList.remove('active');
  document.querySelectorAll('.palette-row').forEach((r, i) => {
    r.classList.toggle('active', i === index);
  });
}

// ── Control Panel ──────────────────────────────────────────
document.getElementById('btn-undo').addEventListener('click', () => {
  if (!undoStack.length) return;
  redoStack.push(snapshotState());
  plateState = undoStack.pop();
  refreshAllWells();
  syncUndoRedoBtns();
});

document.getElementById('btn-redo').addEventListener('click', () => {
  if (!redoStack.length) return;
  undoStack.push(snapshotState());
  plateState = redoStack.pop();
  refreshAllWells();
  syncUndoRedoBtns();
});

document.getElementById('btn-eraser').addEventListener('click', () => {
  eraserMode = !eraserMode;
  document.getElementById('btn-eraser').classList.toggle('active', eraserMode);
  if (eraserMode) {
    document.querySelectorAll('.palette-row').forEach(r => r.classList.remove('active'));
  } else {
    selectColor(activeColor);
  }
});

document.getElementById('btn-clear').addEventListener('click', () => {
  document.getElementById('modal-overlay').classList.add('show');
});

document.getElementById('modal-cancel').addEventListener('click', () => {
  document.getElementById('modal-overlay').classList.remove('show');
});

document.getElementById('modal-confirm').addEventListener('click', () => {
  document.getElementById('modal-overlay').classList.remove('show');
  plateState = {};
  formulas   = Array(NUM_COLORS).fill('');
  undoStack  = [];
  redoStack  = [];
  syncUndoRedoBtns();
  refreshAllWells();
  document.querySelectorAll('.formula-input').forEach(inp => inp.value = '');
  showToast('Plate cleared.');
});

document.getElementById('filename-input').addEventListener('mousedown', e => e.stopPropagation());
document.getElementById('filename-input').addEventListener('keydown',   e => e.stopPropagation());

// ── Keyboard Shortcuts ─────────────────────────────────────
document.addEventListener('keydown', e => {
  if (['INPUT','TEXTAREA'].includes(document.activeElement.tagName)) return;
  if ((e.ctrlKey || e.metaKey) && !e.shiftKey && e.key === 'z') {
    e.preventDefault();
    document.getElementById('btn-undo').click();
  }
  if ((e.ctrlKey || e.metaKey) && (e.key === 'y' || (e.shiftKey && e.key === 'z'))) {
    e.preventDefault();
    document.getElementById('btn-redo').click();
  }
});

// ── Export ─────────────────────────────────────────────────
document.getElementById('btn-export').addEventListener('click', () => {
  const rows = [['Position', 'Formula']];
  let count = 0;

  if (exportByRow) {
    // Row-major: A1, A2, A3 ... A24, B1, B2 ... P24
    ROWS.forEach((_, ri) => {
      COLS.forEach((_, ci) => {
        const key = posKey(ri, ci);
        if (plateState[key] !== undefined) {
          rows.push([key, formulas[plateState[key]] || '']);
          count++;
        }
      });
    });
  } else {
    // Column-major: A1, B1, C1 ... P1, A2, B2 ... P24
    COLS.forEach((_, ci) => {
      ROWS.forEach((_, ri) => {
        const key = posKey(ri, ci);
        if (plateState[key] !== undefined) {
          rows.push([key, formulas[plateState[key]] || '']);
          count++;
        }
      });
    });
  }

  const wb = XLSX.utils.book_new();
  const ws = XLSX.utils.aoa_to_sheet(rows);
  ws['!cols'] = [{ wch: 12 }, { wch: 40 }];
  XLSX.utils.book_append_sheet(wb, ws, 'Input File');

  const filename = resolveFilename();
  const exported = downloadWorkbook(wb, filename);
  if (!exported) {
    showToast('Export failed. Please allow downloads for this page.', 4000);
    return;
  }

  if (count === 0) {
    showToast(`Exported blank template · ${filename}`, 4000);
  } else {
    showToast(`Exported ${count} wells · ${exportByRow ? 'row' : 'column'} order · ${filename}`);
  }
});

// ── Init ───────────────────────────────────────────────────
buildPlate();
buildPalette();
syncUndoRedoBtns();
updateStatusBar();
document.getElementById('plate-grid').addEventListener('contextmenu', e => e.preventDefault());
</script>
</body>
</html>
